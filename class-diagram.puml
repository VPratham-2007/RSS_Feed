@startuml class-diagram
title RSS Feed Reader — Class Diagram (matches server.cpp)

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
}

class "Cache<T>" as Cache <<template>> {
  -data: T
  --
  +Cache()
  +Cache(d: T)
  +showCache(): void
  +getData(): T
}

class Bookmark {
  +url: String
  --
  +Bookmark(u: String)
}

class Feed {
  -{static} totalFeedsCreated: int
  #feedUrl: String
  --
  +Feed()
  +Feed(url: String)
  +Feed(b: Bookmark)
  +{static} displayFeedCount(): void
  +{static} getFeedCount(): int
  +getUrl(): String
  +updateFeed(): void
  +updateFeed(limit: int): String
  +displayInfo(): void
}

class Subscription {
  #planType: String
  #activeDays: int
  --
  +Subscription()
  +Subscription(plan: String, days: int)
  +Subscription(days: int)
  +operator int(): int
  +getPlanString(): String
  +displayPlan(): void
}

class Article {
  #title: String
  #pubDate: String
  #summary: String
  --
  +getTitle(): String
  +getDate(): String
  +getSummary(): String
  +displayArticle(): void
  +displayInfo(): void
}

class ArticleStatus {
  #isRead: bool
  --
  +getRead(): bool
  +displayStatus(): void
}

class FailureNotice {
  -errorCode: int
  --
  +FailureNotice(url: String, code: int)
  +showError(): void
}

class Reader {
  -readerName: String
  --
  +getName(): String
  +displayReaderProfile(): void
}

class FeedException {
  #customMsg: String
  --
  +what(): String
}

class InvalidSubscriptionException {
  +what(): String
}

class Cleanup <<RAII>> {
  +~Cleanup()
}

class ParsedFeed <<struct>> {
  +feedTitle: String
  +articles: List<ArticleStatus>
}

' --- Inheritance (as implemented) ---
Feed <|-- Article
Feed <|-- FailureNotice
Article <|-- ArticleStatus
ArticleStatus <|-- Reader
Subscription <|-- Reader
FeedException <|-- InvalidSubscriptionException

' --- Associations / dependencies ---
Bookmark ..> Feed : converts to\n(class-to-class)
ParsedFeed "1" o-- "0..*" ArticleStatus : holds parsed\nitems of a feed
Feed ..> FeedException : throws when\nload / parse fails
Subscription ..> InvalidSubscriptionException : rejected when\ndays < 0
Cache ..> Feed : reports cached\nitems of a feed URL

note right of Subscription
  Holds the reader's plan
  (Free / Trial / Premium) derived
  from activeDays. int converts to
  Subscription and back.
end note

note bottom of Reader
  Multiple inheritance:
  Reader is an ArticleStatus
  (and therefore an Article and a Feed)
  and also a Subscription.
end note

note right of ArticleStatus
  isRead is the read/unread state of
  an article. The web page toggles it
  with "Mark read / Mark unread".
end note

note right of FailureNotice
  Created in the /api/feed handler when
  a FeedException is caught (HTTP 502).
end note

note right of Cleanup
  Destructor runs when the handler scope
  ends: the "finally" equivalent.
end note

@enduml

          <mxGeometry x="240" y="230" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc_viewlist" value="View article list" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="310" width="160" height="60" as="geometry" />

        </mxCell>
        <mxCell id="uc_failnotice" value="Send failure notice" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc_monitor" value="Monitor feed health" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="230" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc_markread" value="Mark article read" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="310" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Human actors -->
        <mxCell id="actor_reader" value="Reader" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="actor_admin" value="Administrator" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="900" y="150" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Non-human / external system actors -->
        <mxCell id="actor_scheduler" value="Scheduler&#10;&#171;time-triggered&#187;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="30" y="260" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor_feedsource" value="Feed Source&#10;&#171;external system&#187;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="actor_notification" value="Notification Service&#10;&#171;external system&#187;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="850" y="260" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Associations (plain lines, no arrowheads) -->
        <mxCell id="e1" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1" source="actor_reader" target="uc_subscribe">
          <mxGeometry relative="1" as="geometry" />

        <!-- Use cases: right column -->
        <mxCell id="uc_poll" value="Poll feed for updates" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">

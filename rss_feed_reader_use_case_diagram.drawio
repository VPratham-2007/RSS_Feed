<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="Use Case Diagram" id="rssUseCaseDiagram">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="boundary" value="RSS Feed Reader System" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=14;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="600" height="460" as="geometry" />
        </mxCell>

        <!-- Use cases: left column -->
        <mxCell id="uc_subscribe" value="Subscribe to feed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="70" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc_unsubscribe" value="Unsubscribe from feed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">

        <!-- Extend relationship: Poll feed for updates extended by Send failure notice -->
        <mxCell id="ext1" value="&#171;extend&#187;&#10;[fetch fails OR parse error]" style="edgeStyle=none;html=1;endArrow=open;dashed=1;rounded=0;fontStyle=2;" edge="1" parent="1" source="uc_failnotice" target="uc_poll">

        <mxCell id="e9" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;rounded=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="actor_feedsource" target="uc_poll">
          <mxGeometry relative="1" as="geometry" />

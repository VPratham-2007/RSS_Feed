@startuml object-diagram
title RSS Feed Reader — Object Diagram (Sample Instance, matches server.cpp)

skinparam object {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
}

' Reader is an ArticleStatus (-> Article -> Feed) and a Subscription,
' so its object holds the inherited fields as well.
object "reader1 : Reader" as reader1 {
  readerName = "Alice"
  feedUrl = "https://indianexpress.com/section/city/ahmedabad/feed/"
  title = "Welcome"
  isRead = false
  planType = "Premium"
  activeDays = 45
}

object "sub1 : Subscription" as sub1 {
  planType = "Premium"
  activeDays = 45
}

object "bookmark1 : Bookmark" as bookmark1 {
  url = "https://archlinux.org/feeds/news/"
}

object "feed1 : Feed" as feed1 {
  feedUrl = "https://indianexpress.com/section/city/ahmedabad/feed/"
}

object "feed2 : Feed" as feed2 {
  feedUrl = "https://archlinux.org/feeds/news/"
}

object "parsed1 : ParsedFeed" as parsed1 {
  feedTitle = "City - Ahmedabad"
}

object "article1 : ArticleStatus" as article1 {
  feedUrl = "https://indianexpress.com/article/cities/ahmedabad/sample-1/"
  title = "Sample headline 1"
  pubDate = "Wed, 18 Nov 2026 09:00:00 +0530"
  summary = "Short description of the first item"
  isRead = true
}

object "article2 : ArticleStatus" as article2 {
  feedUrl = "https://indianexpress.com/article/cities/ahmedabad/sample-2/"
  title = "Sample headline 2"
  pubDate = "Wed, 18 Nov 2026 10:30:00 +0530"
  summary = "Short description of the second item"
  isRead = false
}

object "cache1 : Cache<string>" as cache1 {
  data = "https://indianexpress.com/section/city/ahmedabad/feed/ (2 cached items)"
}

object "notice1 : FailureNotice" as notice1 {
  feedUrl = "https://example.com/broken-feed"
  errorCode = 502
}

sub1 .. reader1 : plan copied into\nReader(name, sub)
bookmark1 .. feed2 : converted to
feed1 -- parsed1 : load produces
parsed1 -- article1
parsed1 -- article2
cache1 .. feed1 : caches items of
notice1 .. feed1 : created when a\nload like this fails
reader1 .. feed1 : reads from\n(feedUrl)

@enduml
